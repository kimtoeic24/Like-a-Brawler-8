<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>LikeABrawler2</RootNamespace>
    <AssemblyName>Like a Brawler 8</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;YLAD Debug;YLAD Release;Infinite Wealth Debug;Infinite Wealth Release;Demo Debug;Demo Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Util Projects\**" />
    <EmbeddedResource Remove="Util Projects\**" />
    <None Remove="Util Projects\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep explicit references that point to local DLLs or packages folder -->
    <Reference Include="LibARMP">
      <HintPath>Dependencies\LibARMP.dll</HintPath>
    </Reference>
    <Reference Include="PIBLib">
      <HintPath>PIBLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Fody/Costura as PackageReference so we can restore with SDK-style projects -->
    <PackageReference Include="MinHook.NET" Version="1.1.2" />
    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" />
    <PackageReference Include="Yarhl" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Y7Internal.NET\DELibrary.NET\DELibrary.NET.csproj" />
    <ProjectReference Include="Util Projects\ElvisCommand\ElvisCommand.csproj" />
  </ItemGroup>

  <PropertyGroup />

</Project>